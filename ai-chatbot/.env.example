# ==============================================================================
# Environment Configuration for Multimodal Emotional Support Chatbot
# ==============================================================================

# Google Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Database Configuration (MySQL)
# Default format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=multimodal_chatbot
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/multimodal_chatbot

# Fallback to local SQLite if MySQL server is offline during initial local testing
FALLBACK_TO_SQLITE=True
SQLITE_URL=sqlite:///./chatbot_fallback.db

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_URL=http://localhost:8000

# Guardrail & Safety Thresholds
CRISIS_HOTLINE_PRIMARY=988 (USA/Canada Suicide & Crisis Lifeline)
CRISIS_HOTLINE_SECONDARY=112 / 999 / 100 (International & Local Emergency)
CRISIS_TEXT_LINE=Text HOME to 741741
